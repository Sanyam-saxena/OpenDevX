# =============================================================================
# OpenDevX — Environment Variable Reference
# =============================================================================
# Copy this file to .env at the project root for local development.
#
#   cp .env.example .env
#
# The .env file is loaded by Docker Compose and distributed to services via
# env_file directives. Never commit .env or any file containing real secrets.
#
# Values here are development defaults only.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — FastAPI (apps/api)
# -----------------------------------------------------------------------------

# Host address Uvicorn binds to inside the container.
API_HOST=0.0.0.0

# Port Uvicorn listens on inside the container.
API_PORT=8000

# Runtime environment label used by the application.
# One of: development | staging | production
APP_ENV=development

# -----------------------------------------------------------------------------
# Backend — Application Settings (OPENDEVX_ prefix)
# -----------------------------------------------------------------------------
# These variables are consumed by the FastAPI Settings class via pydantic-settings.

OPENDEVX_ENVIRONMENT=development
OPENDEVX_DEBUG=true

# -----------------------------------------------------------------------------
# Frontend — React + Vite (apps/web)
# -----------------------------------------------------------------------------

# Base URL of the OpenDevX API service, as seen from the user's browser.
# In local development this points to the backend container via the published port.
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------

# Name of the development database.
POSTGRES_DB=opendevx

# PostgreSQL superuser for local development.
POSTGRES_USER=opendevx

# PostgreSQL password for local development.
# Change this before sharing or deploying even to staging.
POSTGRES_PASSWORD=opendevx_dev_password

# Application-level database settings (OPENDEVX_ prefix for pydantic-settings).
OPENDEVX_POSTGRES_HOST=db
OPENDEVX_POSTGRES_PORT=5432
OPENDEVX_POSTGRES_DB=opendevx
OPENDEVX_POSTGRES_USER=opendevx
OPENDEVX_POSTGRES_PASSWORD=opendevx_dev_password

# -----------------------------------------------------------------------------
# Cache — Redis
# -----------------------------------------------------------------------------

# Hostname of the Redis service as seen from other containers on the Docker network.
REDIS_HOST=redis

# Port Redis listens on.
REDIS_PORT=6379

# Application-level Redis settings (OPENDEVX_ prefix for pydantic-settings).
OPENDEVX_REDIS_HOST=redis
OPENDEVX_REDIS_PORT=6379
