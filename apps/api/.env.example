# OpenDevX API Environment Configuration
# Copy this file to .env for local overrides.
# In production, set these environment variables directly or pass via container config.

# Environment: development | staging | production
OPENDEVX_ENVIRONMENT=development

# Enable/disable debug mode (Must be false in production)
OPENDEVX_DEBUG=true

# Database Configuration (Set OPENDEVX_USE_SQLITE=false to use PostgreSQL)
OPENDEVX_USE_SQLITE=true
# OPENDEVX_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/opendevx

# Security & Secrets (Change to a strong 32+ char secret key in production!)
OPENDEVX_SECRET_KEY=dev_secret_key_change_in_production_opendevx_2026_secure
OPENDEVX_ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENDEVX_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching (Optional)
# OPENDEVX_REDIS_HOST=localhost
# OPENDEVX_REDIS_PORT=6379
