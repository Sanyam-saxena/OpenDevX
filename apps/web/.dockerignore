# =============================================================================
# OpenDevX Web — Docker build context exclusions
# =============================================================================

# Node.js dependencies (installed inside the container during build)
node_modules

# Build output (not needed in the dev container; generated at build time)
dist

# Test coverage reports
coverage

# Version control
.git
.gitignore
.gitattributes

# Environment files (never bake secrets into the image)
.env
.env.*
.env.local
.env.*.local

# Editor and IDE artifacts
.vscode
.idea
*.code-workspace
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
